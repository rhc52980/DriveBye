<Window x:Class="DiskUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveBye" Height="760" Width="1060"
        MinHeight="560" MinWidth="880"
        Icon="app.ico"
        Background="{StaticResource BgWindow}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- No tile behind it: logo.png is a transparent cutout, so it sits straight on the
                 window background and needs nothing drawn under it. Sourced from the PNG rather
                 than app.ico, because WPF hands back an icon's 16x16 frame and would stretch it. -->
            <Image Grid.Column="0" Source="logo.png" Height="62" Stretch="Uniform"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="DriveBye" Style="{StaticResource TitleText}" />
                <TextBlock Text="Image, verify and erase physical drives" Style="{StaticResource SubtleText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="2" x:Name="RefreshButton" Style="{StaticResource BaseButton}"
                    Margin="0" VerticalAlignment="Center" Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Drive list -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4,2,4,4">
            <DataGrid x:Name="DiskGrid" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46" />
                    <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceId}" Width="Auto" />
                    <DataGridTextColumn Header="MODEL" Binding="{Binding Model}" Width="*" />
                    <DataGridTextColumn Header="CAPACITY" Binding="{Binding SizeDisplay}" Width="Auto" />
                    <DataGridTextColumn Header="BUS" Binding="{Binding InterfaceType}" Width="Auto" />

                    <DataGridTemplateColumn Header="TYPE" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding Media}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="SystemPill" Style="{StaticResource Pill}"
                                        Background="#4A1F22" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10" Foreground="{StaticResource Danger}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="SYSTEM" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Danger}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemDisk}" Value="True">
                                        <Setter TargetName="SystemPill" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0">
                <Button x:Name="CreateImageButton" Style="{StaticResource AccentButton}"
                        Click="CreateImageButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Create Image" />
                    </StackPanel>
                </Button>
                <Button x:Name="VerifyImageButton" Style="{StaticResource BaseButton}"
                        Click="VerifyImageButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Verify vs Image" />
                    </StackPanel>
                </Button>
                <Button x:Name="HashFileButton" Style="{StaticResource BaseButton}"
                        Click="HashFileButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Hash File" />
                    </StackPanel>
                </Button>
                <Button x:Name="EraseSupportButton" Style="{StaticResource BaseButton}"
                        Click="EraseSupportButton_Click"
                        ToolTip="Read-only: asks the drive whether it supports ATA Secure Erase or NVMe Sanitize. Safe on any drive, including the system disk.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Erase Support" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RestoreButton" Style="{StaticResource DangerButton}"
                        Click="RestoreButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Restore Image" />
                    </StackPanel>
                </Button>
                <Button x:Name="WipeButton" Style="{StaticResource DangerButton}"
                        Click="WipeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Wipe" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource BaseButton}"
                        IsEnabled="False" Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Progress -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="ProgressBarCtl"
                         Style="{StaticResource SlimProgressBar}"
                         Minimum="0" Maximum="100" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ProgressText" Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" MinWidth="230" TextAlignment="Right"
                       Margin="16,0,0,0" Text="" />
        </Grid>

        <!-- Log -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0"
                Background="{StaticResource BgConsole}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ACTIVITY" Style="{StaticResource SectionLabel}"
                           Margin="14,10,0,0" />
                <TextBox Grid.Row="1" x:Name="LogBox" Style="{StaticResource ConsoleBox}"
                         Background="Transparent" Padding="14,6,14,12" />
            </Grid>
        </Border>

        <!-- Status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="2,12,0,0">
            <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource Success}"
                    VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SubtleText}" Text="Ready." />
        </StackPanel>
    </Grid>
</Window>
