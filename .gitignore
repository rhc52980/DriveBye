# A copy of the portable build, kept at the repo root for convenience. Not committed: it is
# 63 MB, git keeps every version forever, and it is reproducible with
# `dotnet publish Disk_Utility/DiskUtility.csproj -p:PublishProfile=Portable`.
/DriveBye.exe

# Somewhere to park old build output before deleting it. Nothing in here is needed —
# every build regenerates its own bin/ and obj/.
/junk/
