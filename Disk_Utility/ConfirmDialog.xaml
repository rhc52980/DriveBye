<Window x:Class="DiskUtility.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" SizeToContent="Height" Width="520"
        Background="#1E1E1E" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" Foreground="#EEEEEE" TextWrapping="Wrap"
                   FontSize="13" Margin="0,0,0,14" />

        <StackPanel x:Name="MethodPanel" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Method:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MethodCombo" Width="260" />
        </StackPanel>

        <CheckBox x:Name="VerifyCheck" Foreground="#CCCCCC" Margin="0,0,0,12"
                  Content="Verify after writing" />

        <CheckBox x:Name="AckCheck" Foreground="#E0A0A0" Margin="0,0,0,12"
                  Checked="Gate_Changed" Unchecked="Gate_Changed">
            <TextBlock x:Name="AckText" TextWrapping="Wrap" MaxWidth="440" />
        </CheckBox>

        <TextBlock x:Name="PhraseLabel" Foreground="#E0A0A0" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBox x:Name="InputBox" FontFamily="Consolas" Padding="4"
                 Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#5A5A5A"
                 TextChanged="InputBox_TextChanged" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Width="90" Padding="0,6"
                    Margin="0,0,8,0" Click="CancelBtn_Click" IsCancel="True" />
            <Button x:Name="ProceedBtn" Content="Proceed" Width="110" Padding="0,6"
                    Click="ProceedBtn_Click" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
