<Window x:Class="DiskUtility.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" SizeToContent="Height" Width="580" Icon="app.ico"
        Background="{StaticResource BgWindow}" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1" CornerRadius="10" Margin="12">
        <StackPanel Margin="22,20,22,20">

            <!-- Danger header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource DangerSoft}"
                        BorderBrush="#5E2A2D" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource Danger}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="HeaderText" Text="Destructive operation"
                           FontFamily="{StaticResource UiFont}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"
                       FontSize="13" LineHeight="19" Margin="0,0,0,16" />

            <StackPanel x:Name="MethodPanel" Margin="0,0,0,10">
                <TextBlock Text="METHOD" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <ListBox x:Name="MethodCombo" Style="{StaticResource MethodList}" />
            </StackPanel>

            <StackPanel x:Name="PatternPanel" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Text="PATTERN" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <TextBox x:Name="PatternBox" Style="{StaticResource ModernTextBox}"
                         TextChanged="PatternBox_TextChanged" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="2,7,0,0"
                           Text="Encoded as UTF-8 and repeated unbroken across the whole drive, so it runs on across chunk boundaries rather than restarting." />
            </StackPanel>

            <CheckBox x:Name="VerifyCheck" Style="{StaticResource ModernCheckBox}"
                      Margin="0,0,0,12" Content="Verify after writing" />

            <CheckBox x:Name="AckCheck" Style="{StaticResource ModernCheckBox}"
                      Foreground="{StaticResource Danger}" Margin="0,0,0,14"
                      Checked="Gate_Changed" Unchecked="Gate_Changed">
                <TextBlock x:Name="AckText" TextWrapping="Wrap" MaxWidth="460" />
            </CheckBox>

            <Border Background="{StaticResource BgConsole}" BorderBrush="#5E2A2D" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock x:Name="PhraseLabel" Foreground="{StaticResource Danger}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBox}"
                             TextChanged="InputBox_TextChanged" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource BaseButton}"
                        MinWidth="100" Margin="0,0,8,0" Click="CancelBtn_Click" IsCancel="True" />
                <Button x:Name="ProceedBtn" Content="Proceed" Style="{StaticResource DangerButton}"
                        MinWidth="120" Margin="0" Click="ProceedBtn_Click" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
